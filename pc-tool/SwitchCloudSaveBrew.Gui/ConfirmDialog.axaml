<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SwitchCloudSaveBrew.Gui.ConfirmDialog"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Confirm overwrite"
        Name="Root">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="CancelButton" Content="Cancel" Click="OnCancelClick" />
            <Button Name="OverwriteButton" Content="Overwrite" Click="OnConfirmClick" />
        </StackPanel>
    </StackPanel>
</Window>
